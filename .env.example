# --- API process (RLS path). Connects as somnia_api; never give it the service URL. ---
SOMNIA_API_DATABASE_URL=postgresql://somnia_api:somnia_api_local@127.0.0.1:54322/postgres
SOMNIA_RECENCY_HALF_LIFE_DAYS=30
SOMNIA_DEFAULT_TOKEN_BUDGET=2000
# tiktoken encoding used to count token_budget: o200k_base | cl100k_base | p50k_base | r50k_base
SOMNIA_TOKEN_ENCODING=o200k_base

# --- Worker / admin CLI only (bypasses RLS). ---
SOMNIA_SERVICE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SOMNIA_DREAM_INTERVAL_S=3600
SOMNIA_SIMILARITY_THRESHOLD=0.85
SOMNIA_DECAY_AFTER_DAYS=14
SOMNIA_DECAY_FACTOR=0.9

# --- LLM + embeddings: "fake" (deterministic, offline) or "openai" (any OpenAI-compatible API). ---
SOMNIA_PROVIDER=fake
SOMNIA_LLM_BASE_URL=https://api.openai.com/v1
SOMNIA_LLM_API_KEY=
SOMNIA_CHAT_MODEL=gpt-4o-mini
SOMNIA_EMBEDDING_MODEL=text-embedding-3-small

# --- Tests: a postgres+pgvector superuser URL; tests create and drop a throwaway DB. ---
SOMNIA_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
